				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=c++11" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/RollingBall" prefix_auto="1" extension_auto="1" />
